│   ├── design/                 # E. Blocked randomized experiment design
│   │   ├── models.py           # DoseLevel, WindowSpec, ExperimentDesign
│   │   └── designer.py         # ExperimentDesigner (OAT, rank check)
│   ├── telemetry/              # F. Measurement and telemetry
